<?xml version="1.0" encoding="utf-8"?>
<style xmlns="http://purl.org/net/xbiblio/csl" version="1.0" class="in-text" default-locale="en-US">
  <info>
    <title>DYNA (Universidad Nacional de Colombia, 2026 template)</title>
    <title-short>DYNA UNAL 2026</title-short>
    <id>http://www.zotero.org/styles/dyna-universidad-nacional-de-colombia-2026-template</id>
    <link href="http://www.zotero.org/styles/dyna-universidad-nacional-de-colombia-2026-template" rel="self"/>
    <link href="https://revistas.unal.edu.co/index.php/dyna/about/submissions" rel="documentation"/>
    <author>
      <name>OpenAI Codex</name>
    </author>
    <category citation-format="numeric"/>
    <category field="engineering"/>
    <issn>0012-7353</issn>
    <eissn>2346-2183</eissn>
    <summary>Numeric style based on the official 2026 DYNA article template of the Universidad Nacional de Colombia.</summary>
    <updated>2026-07-29T00:00:00+00:00</updated>
    <rights license="http://creativecommons.org/licenses/by-sa/3.0/">This work is licensed under a Creative Commons Attribution-ShareAlike 3.0 License.</rights>
  </info>

  <locale xml:lang="en">
    <terms>
      <term name="and">and</term>
      <term name="available at">Available at:</term>
      <term name="accessed">accessed</term>
      <term name="page-range-delimiter">-</term>
      <term name="page" form="short">
        <single>p.</single>
        <multiple>pp.</multiple>
      </term>
    </terms>
  </locale>

  <macro name="author">
    <names variable="author">
      <name name-as-sort-order="all"
            sort-separator=", "
            initialize-with="."
            delimiter=", "
            delimiter-precedes-last="always"
            and="text"/>
      <substitute>
        <names variable="editor"/>
        <text variable="publisher"/>
        <text variable="title"/>
      </substitute>
    </names>
  </macro>

  <macro name="editor">
    <names variable="editor">
      <name name-as-sort-order="all"
            sort-separator=", "
            initialize-with="."
            delimiter=", "
            delimiter-precedes-last="always"
            and="text"/>
      <label form="short" prefix=", "/>
    </names>
  </macro>

  <macro name="issued">
    <date variable="issued">
      <date-part name="year"/>
    </date>
  </macro>

  <macro name="accessed">
    <date variable="accessed">
      <date-part name="day" suffix=" "/>
      <date-part name="month" form="long" suffix=" "/>
      <date-part name="year"/>
    </date>
  </macro>

  <macro name="doi">
    <choose>
      <if variable="DOI">
        <text variable="DOI" prefix="DOI: https://doi.org/"/>
      </if>
    </choose>
  </macro>

  <macro name="online">
    <choose>
      <if variable="URL">
        <group delimiter=" ">
          <text term="available at" suffix=":"/>
          <text variable="URL"/>
        </group>
      </if>
    </choose>
  </macro>

  <macro name="article">
    <group delimiter=". ">
      <group delimiter=", ">
        <text macro="author"/>
        <text variable="title"/>
        <text variable="container-title" font-style="italic"/>
        <group delimiter="">
          <text variable="volume"/>
          <text variable="issue" prefix="(" suffix=")"/>
        </group>
        <group delimiter=" ">
          <label variable="page" form="short"/>
          <text variable="page"/>
        </group>
        <text macro="issued"/>
      </group>
      <text macro="doi"/>
    </group>
  </macro>

  <macro name="book">
    <group delimiter=", ">
      <text macro="author"/>
      <text variable="title" font-style="italic"/>
      <text variable="edition" suffix=" ed."/>
      <text variable="publisher"/>
      <text variable="publisher-place"/>
      <text macro="issued"/>
      <group delimiter=" ">
        <label variable="page" form="short"/>
        <text variable="page"/>
      </group>
    </group>
  </macro>

  <macro name="chapter">
    <group delimiter=", ">
      <text macro="author"/>
      <text variable="title"/>
      <group delimiter=" ">
        <text value="in:"/>
        <text macro="editor"/>
      </group>
      <text variable="container-title" font-style="italic"/>
      <text variable="edition" suffix=" ed."/>
      <text variable="publisher"/>
      <text variable="publisher-place"/>
      <text macro="issued"/>
      <group delimiter=" ">
        <label variable="page" form="short"/>
        <text variable="page"/>
      </group>
    </group>
  </macro>

  <macro name="thesis">
    <group delimiter=", ">
      <text macro="author"/>
      <text variable="title" font-style="italic"/>
      <text variable="genre"/>
      <text variable="publisher-place"/>
      <text variable="publisher"/>
      <text macro="issued"/>
      <text variable="number-of-pages" suffix=" p."/>
    </group>
  </macro>

  <macro name="conference">
    <group delimiter=", ">
      <text macro="author"/>
      <text variable="title"/>
      <group delimiter=" ">
        <text value="in:"/>
        <text variable="event-title"/>
      </group>
      <text variable="publisher-place"/>
      <text variable="publisher"/>
      <text macro="issued"/>
      <group delimiter=" ">
        <label variable="page" form="short"/>
        <text variable="page"/>
      </group>
    </group>
  </macro>

  <macro name="report">
    <group delimiter=", ">
      <text macro="author"/>
      <text variable="title" font-style="italic"/>
      <text variable="publisher-place"/>
      <text variable="publisher"/>
      <text macro="issued"/>
      <text variable="number" prefix="no. "/>
    </group>
  </macro>

  <macro name="webpage">
    <group delimiter=". ">
      <text macro="author"/>
      <text variable="title"/>
      <text variable="container-title" font-style="italic"/>
      <text macro="issued"/>
      <group prefix="[" suffix="]" delimiter=" ">
        <text term="accessed"/>
        <text macro="accessed"/>
      </group>
      <text macro="online"/>
    </group>
  </macro>

  <macro name="bibliography-entry">
    <choose>
      <if type="article-journal article-magazine article-newspaper" match="any">
        <text macro="article"/>
      </if>
      <else-if type="chapter paper-conference" match="any">
        <choose>
          <if type="paper-conference">
            <text macro="conference"/>
          </if>
          <else>
            <text macro="chapter"/>
          </else>
        </choose>
      </else-if>
      <else-if type="book">
        <text macro="book"/>
      </else-if>
      <else-if type="thesis">
        <text macro="thesis"/>
      </else-if>
      <else-if type="report">
        <text macro="report"/>
      </else-if>
      <else-if type="webpage post post-weblog" match="any">
        <text macro="webpage"/>
      </else-if>
      <else>
        <group delimiter=", ">
          <text macro="author"/>
          <text variable="title" font-style="italic"/>
          <text variable="container-title"/>
          <text variable="publisher-place"/>
          <text variable="publisher"/>
          <text macro="issued"/>
        </group>
      </else>
    </choose>
  </macro>

  <citation collapse="citation-number">
    <sort>
      <key variable="citation-number"/>
    </sort>
    <layout prefix="[" suffix="]" delimiter=",">
      <text variable="citation-number"/>
    </layout>
  </citation>

  <bibliography et-al-min="7" et-al-use-first="6" entry-spacing="0" line-spacing="1">
    <sort>
      <key variable="citation-number"/>
    </sort>
    <layout suffix=".">
      <text macro="bibliography-entry"/>
    </layout>
  </bibliography>
</style>
